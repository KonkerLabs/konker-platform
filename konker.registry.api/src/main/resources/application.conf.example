mongo {
  hostname = "localhost"
  port = 27017

}

mongoAudit {
  hostname = "localhost"
  port = 27017
}

integration {
    timeout: [
        {
            default = 3000
            enrichment = 3000
            sms = 3000
        }
    ]
}

password.user {
  hash.algorithm = "SHA256"
  salt.size = 16
  iterations = 10000
}

eventstorage {
    bean="cassandraEvents"
}

cassandra {
    clustername = "konker"
    keyspace = "registrykeyspace"
    hostname = "CHANGE_ME"
    username = "CHANGE_ME"
    password = "CHANGE_ME"    
    port=9042
}