mongo {
  hostname = "mongodb"
  port = 27017
  username = "registry"
  password = "registry"
}

mongoAudit {
  hostname = "mongodb"
  port = 27017
  username = "registry"
  password = "registry"
}

mongoBilling {
  hostname = "mongodb"
  port = 27017
  username = "registry"
  password = "registry"
}

integration {
    timeout: [
        {
            default = 3000
            enrichment = 3000
            sms = 3000
        }
    ]
}

password.user {
  hash.algorithm = "SHA256"
  salt.size = 16
  iterations = 10000
}

eventstorage {
    bean="cassandraEvents"
}

cassandra {
    clustername = "registry"
    datacenter = "registry"
    keyspace = "registry"
    hostname = "casssanda"
    username = "casssanda"
    password = "casssanda"
    port=9042
}